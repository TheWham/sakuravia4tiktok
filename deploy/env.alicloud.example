APP_HOST=127.0.0.1
APP_PORT=8000
SQLITE_PATH=data/tasks.db
OUTPUT_DIR=data/output
KEEP_AUDIO_AFTER_SUCCESS=false

# Ubuntu 上使用 PATH 中的命令名，不要填写 Windows 绝对路径。
YT_DLP_BIN=yt-dlp
YT_DLP_COOKIES_FILE=data/Douyin-cookies.txt
FFMPEG_BIN=ffmpeg

# V3 默认走阿里云百炼 Paraformer；Groq 只作为可切换旧 Provider 保留。
ASR_PROVIDER=aliyun_paraformer
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_ASR_MODEL=paraformer-v2
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_SIGNED_URL_EXPIRES_SECONDS=3600
ALIYUN_ASR_POLL_INTERVAL_SECONDS=5
ALIYUN_ASR_TIMEOUT_SECONDS=1800

GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
MAIL_FROM=
MAIL_TO=

# 首次上云先关闭监听，等手动 BV 摘要和邮件链路跑通后再打开。
Douyin_ENABLE_LISTENER=false
Douyin_COOKIE=
Douyin_SELF_MID=
Douyin_POLL_MIN_SECONDS=180
Douyin_POLL_MAX_SECONDS=480
Douyin_REQUEST_TIMEOUT_SECONDS=15

