APP_HOST=127.0.0.1
APP_PORT=8000
SQLITE_PATH=data/tasks.db
OUTPUT_DIR=data/output
KEEP_AUDIO_AFTER_SUCCESS=false

# Playwright browser cookie file (Netscape format).
DOUYIN_COOKIES_FILE=path/to/your_cookies.txt

FFMPEG_BIN=ffmpeg

# ── Summary provider (mimo / deepseek) ──
SUMMARY_PROVIDER=mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_MEDIA_MODE=auto
MIMO_MAX_COMPLETION_TOKENS=4096

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# ── ASR (speech-to-text) ──
ASR_PROVIDER=aliyun_paraformer
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_ASR_MODEL=paraformer-v2
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_SIGNED_URL_EXPIRES_SECONDS=3600

GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# ── Mail ──
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
MAIL_FROM=
MAIL_TO=

# ── Douyin listener (optional) ──
DOUYIN_ENABLE_LISTENER=false
DOUYIN_COOKIE=
DOUYIN_SELF_MID=
DOUYIN_POLL_MIN_SECONDS=180
DOUYIN_POLL_MAX_SECONDS=480
DOUYIN_REQUEST_TIMEOUT_SECONDS=15
